\@writefile{lof}{\contentsline {figure}{\numberline {14}{\ignorespaces \textbf  {S3: Relationship between article counts and IPC phase (CS score).} \textbf  {Left:} GDELT Events. \textbf  {Right:} GDELT GKG. Each point is a country-period; lines indicate OLS linear fits without fixed effects.}}{43}{figure.caption.36}\protected@file@percent }
\newlabel{fig:appendix_raw_scatter}{{14}{43}{\textbf {S3: Relationship between article counts and IPC phase (CS score).} \textbf {Left:} GDELT Events. \textbf {Right:} GDELT GKG. Each point is a country-period; lines indicate OLS linear fits without fixed effects}{figure.caption.36}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {15}{\ignorespaces \textbf  {S4: Proportional response of news volume to IPC severity (GDELT Events).} Each point is a country–period observation; the red line is a raw OLS fit (without fixed effects). The boxed annotation reports the country- and period-FE-adjusted semi-elasticity from the panel regression $\log (1+\text  {articles}) \sim \text  {CS\_score} + C(\text  {ADMIN0}) + C(\text  {period})$, restricted to country-months with non-zero total volume ($N=404$). \textbf  {Left:} food-security-keyword-filtered articles (CAMEO-screened). \textbf  {Right:} total country–month articles (unfiltered, pulled from the public \texttt  {gdelt-bq.gdeltv2.events} dataset). At the country-month aggregation, FS-filtered news rises by approximately $+12.6\%$ per IPC phase ($p<0.01$), roughly twice the proportional response of total country-month news ($+6.3\%$ per IPC phase, $p\approx 0.05$). The keyword filter therefore amplifies the proportional response of news activity to food security severity, particularly in low-baseline-coverage countries that level regressions implicitly downweight.}}{44}{figure.caption.37}\protected@file@percent }
\newlabel{fig:appendix_log_scatter}{{15}{44}{\textbf {S4: Proportional response of news volume to IPC severity (GDELT Events).} Each point is a country–period observation; the red line is a raw OLS fit (without fixed effects). The boxed annotation reports the country- and period-FE-adjusted semi-elasticity from the panel regression $\log (1+\text {articles}) \sim \text {CS\_score} + C(\text {ADMIN0}) + C(\text {period})$, restricted to country-months with non-zero total volume ($N=404$). \textbf {Left:} food-security-keyword-filtered articles (CAMEO-screened). \textbf {Right:} total country–month articles (unfiltered, pulled from the public \texttt {gdelt-bq.gdeltv2.events} dataset). At the country-month aggregation, FS-filtered news rises by approximately $+12.6\%$ per IPC phase ($p<0.01$), roughly twice the proportional response of total country-month news ($+6.3\%$ per IPC phase, $p\approx 0.05$). The keyword filter therefore amplifies the proportional response of news activity to food security severity, particularly in low-baseline-coverage countries that level regressions implicitly downweight}{figure.caption.37}{}}
