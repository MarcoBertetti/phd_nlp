\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces Top 20 features by importance (Random Forest, next-IPC prediction). \textbf  {(a)}~Full model (IPC + GDELT + temporal): the most recent IPC score dominates, followed by country fixed effects; among GDELT features, displacement and food insecurity rolling averages rank highest. \textbf  {(b)}~GDELT-only model: without lagged IPC scores, geographic context absorbs much of the importance, with temporal GDELT features---particularly displacement frequency and food insecurity frequency rolling averages---emerging as the leading news-derived signals. Feature categories are colour-coded: \textcolor [HTML]{2166ac}{IPC history}, \textcolor [HTML]{969696}{geographic}, \textcolor [HTML]{e6550d}{GDELT base}, \textcolor [HTML]{756bb1}{GDELT temporal}.}}{31}{figure.caption.17}\protected@file@percent }
\newlabel{fig:feature_importance}{{8}{31}{Top 20 features by importance (Random Forest, next-IPC prediction). \textbf {(a)}~Full model (IPC + GDELT + temporal): the most recent IPC score dominates, followed by country fixed effects; among GDELT features, displacement and food insecurity rolling averages rank highest. \textbf {(b)}~GDELT-only model: without lagged IPC scores, geographic context absorbs much of the importance, with temporal GDELT features---particularly displacement frequency and food insecurity frequency rolling averages---emerging as the leading news-derived signals. Feature categories are colour-coded: \textcolor [HTML]{2166ac}{IPC history}, \textcolor [HTML]{969696}{geographic}, \textcolor [HTML]{e6550d}{GDELT base}, \textcolor [HTML]{756bb1}{GDELT temporal}}{figure.caption.17}{}}
