\newlabel{tab:appendix_regression_summary}{{4}{44}{Association between article counts and IPC CS scores. Each column shows results from OLS regressions with country and period fixed effects. Standard errors in parentheses. $^{***}p<0.01$}{table.caption.38}{}}
\@writefile{lot}{\contentsline {table}{\numberline {5}{\ignorespaces Lead-lag diagnostic: today's FS-filtered article volume predicting the IPC CS score at the $k$th next observed assessment ($k=1,\dots  ,4$). Two specifications per horizon: (a) GDELT only; (b) controlling for today's IPC (\texttt  {CS\_score}). All columns include country and period fixed effects on the same panel as Table~\ref {tab:appendix_regression_summary}. Coefficients on \texttt  {articles\_between} are reported in their natural units (per article) and rounded to three decimals; a 100-article shift therefore corresponds to coefficient $\times 100$ in IPC phase units. Coef (p-value); $^{***}p<0.01$, $^{**}p<0.05$, $^{*}p<0.10$.}}{45}{table.caption.39}\protected@file@percent }
\newlabel{tab:lead_lag_diagnostic}{{5}{45}{Lead-lag diagnostic: today's FS-filtered article volume predicting the IPC CS score at the $k$th next observed assessment ($k=1,\dots ,4$). Two specifications per horizon: (a) GDELT only; (b) controlling for today's IPC (\texttt {CS\_score}). All columns include country and period fixed effects on the same panel as Table~\ref {tab:appendix_regression_summary}. Coefficients on \texttt {articles\_between} are reported in their natural units (per article) and rounded to three decimals; a 100-article shift therefore corresponds to coefficient $\times 100$ in IPC phase units. Coef (p-value); $^{***}p<0.01$, $^{**}p<0.05$, $^{*}p<0.10$}{table.caption.39}{}}
